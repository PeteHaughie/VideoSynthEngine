{
  "$schema": "./control-map.schema.json",
  "device": "./nk2-layout.json",
  "notes": "Current VideoSynthEngine bindings. Faders (CC 0-7) and the first six pots (CC 16-21) are preset-scoped, driving shader parameter slots 0-13 of whichever preset is active. The last two pots (CC 22-23) are reserved for the LFO depth/rate controls.",
  "bindings": [
    { "cc": 0,  "control": "ch1.fader", "target": "slider0", "kind": "continuous", "scope": "preset", "note": "Shader param slot 0 of the active preset." },
    { "cc": 1,  "control": "ch2.fader", "target": "slider1", "kind": "continuous", "scope": "preset", "note": "Shader param slot 1 of the active preset." },
    { "cc": 2,  "control": "ch3.fader", "target": "slider2", "kind": "continuous", "scope": "preset" },
    { "cc": 3,  "control": "ch4.fader", "target": "slider3", "kind": "continuous", "scope": "preset" },
    { "cc": 4,  "control": "ch5.fader", "target": "slider4", "kind": "continuous", "scope": "preset" },
    { "cc": 5,  "control": "ch6.fader", "target": "slider5", "kind": "continuous", "scope": "preset" },
    { "cc": 6,  "control": "ch7.fader", "target": "slider6", "kind": "continuous", "scope": "preset" },
    { "cc": 7,  "control": "ch8.fader", "target": "slider7", "kind": "continuous", "scope": "preset" },

    { "cc": 16, "control": "ch1.pot", "target": "knob0", "kind": "continuous", "scope": "preset", "note": "Shader param slot 8 of the active preset." },
    { "cc": 17, "control": "ch2.pot", "target": "knob1", "kind": "continuous", "scope": "preset" },
    { "cc": 18, "control": "ch3.pot", "target": "knob2", "kind": "continuous", "scope": "preset" },
    { "cc": 19, "control": "ch4.pot", "target": "knob3", "kind": "continuous", "scope": "preset" },
    { "cc": 20, "control": "ch5.pot", "target": "knob4", "kind": "continuous", "scope": "preset" },
    { "cc": 21, "control": "ch6.pot", "target": "knob5", "kind": "continuous", "scope": "preset" },
    { "cc": 22, "control": "ch7.pot", "target": "hueLfoDepth", "kind": "continuous", "range": { "in": [-1.0, 1.0], "out": [0.0, 1.0] }, "note": "Reserved for LFO depth; not a preset param slot." },
    { "cc": 23, "control": "ch8.pot", "target": "hueLfoRate", "kind": "continuous", "range": { "in": [-1.0, 1.0], "out": [0.02, 2.0] }, "note": "Reserved for LFO rate; not a preset param slot." },

    { "cc": 1, "control": "ch2.fader", "target": "videoIndex", "kind": "continuous", "range": { "in": [-1.0, 1.0] }, "condition": "SOURCE_PLAYBACK with files present", "note": "Overloads the slider1 binding above; scrubs the loaded video file index." },

    { "cc": 41, "control": "transport.play", "target": "prevPreset", "kind": "trigger", "note": "Physical PLAY button." },
    { "cc": 42, "control": "transport.stop", "target": "nextPreset", "kind": "trigger", "note": "Physical STOP button." },
    { "cc": 43, "control": "transport.reverse", "target": "debug", "kind": "trigger", "note": "Physical REW button." },
    { "cc": 44, "control": "transport.forward", "target": "prev", "kind": "trigger", "note": "Physical FF button; previous video file." },
    { "cc": 45, "control": "transport.record", "target": "next", "kind": "trigger", "note": "Physical REC button; next video file." },
    { "cc": 62, "control": "marker.right", "target": "reset", "kind": "trigger", "note": "Physical MARKER > button; reloads preset 0." }
  ]
}
